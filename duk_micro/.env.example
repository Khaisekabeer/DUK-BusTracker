# ─────────────────────────────────────────────────────────────────────────────
# DUK Bus Tracker Backend — Production Environment Variables
#
# INSTRUCTIONS:
#   1. Copy this file to /etc/duk/production.env on the server
#   2. Fill in all values marked as REQUIRED
#   3. Set file permissions: chmod 600 /etc/duk/production.env
#   4. Never commit this file to git (it's in .gitignore)
#
# Generate strong secrets with:
#   openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# REQUIRED: Update with your server's PostgreSQL credentials
DATABASE_URL=postgresql+asyncpg://duk_user:CHANGE_ME@localhost:5432/duk_bus

# ── Redis ─────────────────────────────────────────────────────────────────────
# Default local Redis — no password needed if Redis is local-only
REDIS_URL=redis://localhost:6379/0

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# REQUIRED: Generate with: openssl rand -hex 32
SECRET_KEY=GENERATE_THIS_WITH_OPENSSL_RAND_HEX_32

# ── GPS Device ───────────────────────────────────────────────────────────────
# REQUIRED: The API key the hardware GPS device must send with each request
# The device should be configured to use this same key
GPS_API_KEY=CHANGE_ME_STRONG_GPS_KEY

# ── Admin Panel ───────────────────────────────────────────────────────────────
# REQUIRED: Generate with: openssl rand -hex 32
ADMIN_TOKEN=GENERATE_THIS_WITH_OPENSSL_RAND_HEX_32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# ── Email (OTP Delivery) ──────────────────────────────────────────────────────
# REQUIRED: Gmail app password (not your regular password)
# Create at: myaccount.google.com → Security → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password-here
SMTP_FROM=DUK Bus Tracker <your-email@gmail.com>

# ── Firebase Push Notifications ───────────────────────────────────────────────
# REQUIRED: From Firebase Console → Project Settings → Cloud Messaging
# FCM_SERVER_KEY: Legacy server key (for direct FCM v1 API calls)
FCM_SERVER_KEY=your-fcm-server-key-here
FIREBASE_PROJECT_ID=your-firebase-project-id

# ── CORS ──────────────────────────────────────────────────────────────────────
# REQUIRED: Set to your actual domain once IT provides it
# This controls which websites can call the API
ALLOWED_ORIGINS=https://YOUR_DOMAIN_HERE

# ── OSRM ──────────────────────────────────────────────────────────────────────
# Local OSRM instance running in Docker (see deploy/osrm-setup.sh)
OSRM_URL=http://127.0.0.1:5001

# ── Security ──────────────────────────────────────────────────────────────────
ALLOWED_EMAIL_DOMAIN=duk.ac.in
